# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.
# Cada bloque se activará en la fase indicada (ver docs/roadmap.md y docs/developer-accounts.md).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Fase 1, región UE) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=          # solo servidor

# --- Cifrado de tokens OAuth (Fase 1) ---
# TOKEN_ENCRYPTION_KEY=               # 32 bytes en base64; solo servidor
