# Copia este archivo a .env.local y rellena los valores. Nunca subas .env.local al repo.
# En Vercel: Project → Settings → Environment Variables (marca como "Sensitive" todo lo que diga SECRETO).
# Sin una variable, la función correspondiente queda desactivada y la UI lo indica (no rompe la app).

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000          # en producción: https://<tu-dominio>

# --- Supabase (proyecto "kreo", eu-central-1) ---
NEXT_PUBLIC_SUPABASE_URL=https://qowvtzqqrmccuavqtsgr.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=               # pública (sb_publishable_...)
SUPABASE_SECRET_KEY=                                # SECRETO (sb_secret_...). Solo servidor: lista de espera, worker, OAuth

# --- Servidor MCP · OAuth para conectores de Claude (opcionales) ---
# La URL del conector es ${NEXT_PUBLIC_APP_URL}/api/mcp: NEXT_PUBLIC_APP_URL debe ser EXACTAMENTE la URL pública
# que se pega en Claude (p. ej. https://kreo-nine.vercel.app), sin barra final.
MCP_CIMD_ALLOWED_HOSTS=claude.ai,claude.com          # hosts cuyos Client ID Metadata Documents se aceptan (lista cerrada)
MCP_OAUTH_RATE_SALT=                                # SECRETO opcional: clave HMAC para limitar por IP sin guardar la IP (por defecto deriva de SUPABASE_SECRET_KEY)

# --- Cifrado de tokens OAuth ---
# SECRETO. 32 bytes en base64. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ¡No cambiarla una vez en uso! (los tokens guardados dejarían de poder descifrarse)
TOKEN_ENCRYPTION_KEY=

# --- Email transaccional (Resend; proveedor por decidir) ---
RESEND_API_KEY=                                     # SECRETO
EMAIL_FROM="Kreo <hola@tu-dominio.com>"

# --- Inngest (colas y tareas programadas) ---
INNGEST_EVENT_KEY=                                  # SECRETO
INNGEST_SIGNING_KEY=                                # SECRETO

# --- TikTok for Developers (Login Kit + Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=                               # SECRETO
# Poner a "true" SOLO cuando TikTok apruebe la auditoría de Direct Post. Mientras no sea "true", TikTok se envía por
# defecto a los borradores del creador (scope video.upload) y, si no se puede, queda «listo para subir a mano».
TIKTOK_DIRECT_POST_AUDITED=false

# --- Meta (Instagram API con Facebook Login) ---
META_APP_ID=
META_APP_SECRET=                                    # SECRETO
META_LOGIN_CONFIG_ID=                               # ID de la "configuración" de Facebook Login for Business (apps tipo Empresa). No es secreto.
META_INBOX_LOGIN_CONFIG_ID=                         # Opcional: configuración aparte para la Bandeja (si no, usa META_LOGIN_CONFIG_ID)
META_GRAPH_VERSION=v27.0                            # = versión del webhook; una app nueva no puede usar versiones anteriores a su creación

# --- Google (YouTube Data API + YouTube Analytics) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=                               # SECRETO
GOOGLE_OAUTH_IN_PRODUCTION=false                    # true cuando Google pase la app a «En producción»: deja de avisar de que el permiso de YouTube caduca a los 7 días

# --- IA ---
FAL_KEY=                                            # SECRETO. Imagen (fal.ai)
ANTHROPIC_API_KEY=                                  # SECRETO. Texto (agentes con Claude)

# --- Stripe (compra de créditos dentro de la app) ---
STRIPE_SECRET_KEY=                                  # SECRETO (sk_live_... o sk_test_... para pruebas)
STRIPE_WEBHOOK_SECRET=                              # SECRETO (whsec_...). Webhook: https://<dominio>/api/stripe/webhook
STRIPE_TAX_ENABLED=false                            # true cuando actives Stripe Tax (IVA UE) en el panel de Stripe

# --- Investigación (Fase 2) ---
GOOGLE_API_KEY=                                     # SECRETO. YouTube Data API v3 (solo datos públicos de canales)
YOUTUBE_DERIVED_METRICS_APPROVED=false              # true SOLO tras aprobar Google la auditoría (outliers, medianas, IA sobre canales ajenos)
META_AD_LIBRARY_TOKEN=                              # SECRETO. Meta Ad Library API (requiere verificación de identidad)
META_CLIENT_TOKEN=                                  # Opcional. oEmbed de Instagram (junto a META_APP_ID)

# --- Bandeja (Fase 3) ---
META_WEBHOOK_VERIFY_TOKEN=                          # SECRETO. Webhook: https://<dominio>/api/inbox/meta/webhook (campo messages)
META_HUMAN_AGENT_ENABLED=false                      # true SOLO si Meta aprueba la etiqueta HUMAN_AGENT
MICROSOFT_CLIENT_ID=                                # Outlook (Microsoft Graph: Mail.Read, Mail.Send, offline_access)
MICROSOFT_CLIENT_SECRET=                            # SECRETO
# Redirects: https://<dominio>/api/inbox/oauth/{gmail|outlook|instagram}/callback

# --- Audio (ElevenLabs; el uso comercial exige plan de pago) ---
ELEVENLABS_API_KEY=                                 # SECRETO
ELEVENLABS_BASE_URL=                                # Opcional

# --- Shopify (Fase 4) ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=                                 # SECRETO
# App URL: https://<dominio>/api/shopify/install · Redirect: /api/shopify/callback · Webhooks: /api/shopify/webhooks

# --- Suscripciones y afiliados (Fase 4; precios provisionales en src/lib/billing/plans.ts) ---
STRIPE_PRICE_PRO=                                   # Opcional. price_... (o lookup_key kreo_pro_monthly)
STRIPE_PRICE_AGENCY=                                # Opcional. price_... (o lookup_key kreo_agency_monthly)
STRIPE_PORTAL_CONFIGURATION_ID=                     # Opcional. bpc_...
AFFILIATE_COMMISSION_RATE=0.2                       # Provisional
AFFILIATE_COMMISSION_MONTHS=12                      # Provisional
KREO_STAFF_EMAILS=                                  # Emails del equipo de Kreo que pueden marcar comisiones como pagadas
